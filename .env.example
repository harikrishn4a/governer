# Copy to .env and fill in your keys: cp .env.example .env
# Both apps/web and apps/agents load this repo-root .env. Never commit the real .env.

# ── Discovery ────────────────────────────────────────────────
# Exa API key — https://dashboard.exa.ai/
EXA_API_KEY=your_exa_api_key_here

# ── LLM ──────────────────────────────────────────────────────
# Vercel AI Gateway (preferred) — https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Direct LLM keys (used as fallback when the gateway key is unset)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────
# Local Docker Postgres. Port 5433 avoids the macOS Postgres.app default (5432).
DATABASE_URL=postgresql://agentbid:agentbid@localhost:5433/agentbid

# ── Stripe (test mode) — https://dashboard.stripe.com/test/apikeys ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Servers ──────────────────────────────────────────────────
PORT=4000
AGENTS_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
