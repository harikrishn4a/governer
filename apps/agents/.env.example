# LLM keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Exa
EXA_API_KEY=...

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...

# Database
# Use 5433 if Postgres.app occupies 5432 on macOS
DATABASE_URL=postgresql://agentbid:agentbid@localhost:5433/agentbid

# Server
PORT=4000

# Web app base URL — agents POST live events to {WEB_URL}/api/stream/ingest
WEB_URL=http://localhost:3000

# Optional: override default Claude model
# ANTHROPIC_MODEL=claude-sonnet-4-5
