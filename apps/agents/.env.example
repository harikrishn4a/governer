# LLM keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Exa
EXA_API_KEY=...

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...

# Database
# Use 5433 if Postgres.app occupies 5432 on macOS
DATABASE_URL=postgresql://agentbid:agentbid@localhost:5433/agentbid

# Server
PORT=4000

# Web app SSE endpoint (for event bus in future)
# SSE_ENDPOINT=http://localhost:3000/api/stream

# Optional: override default Claude model
# ANTHROPIC_MODEL=claude-sonnet-4-5
