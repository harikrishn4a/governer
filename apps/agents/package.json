{
  "name": "@agentbid/agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first node dist/index.js",
    "test:discovery": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/test-discovery.ts",
    "test:e2e": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/test-e2e.ts",
    "test:auction": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/test-auction.ts",
    "test:auction-e2e": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/test-auction-e2e.ts",
    "test:phase5-db": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/test-phase5-db.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.81",
    "@ai-sdk/openai": "^2.0.106",
    "@anthropic-ai/sdk": "^0.30.0",
    "@stripe/agent-toolkit": "^0.9.0",
    "@types/pg": "^8.20.0",
    "ai": "^5.0.197",
    "dotenv": "^17.4.2",
    "exa-js": "^2.13.0",
    "express": "^4.21.0",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "stripe": "^22.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
